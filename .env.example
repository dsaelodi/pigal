# ==============================================================================
# PIGAL - Scam & Illegal Lending Risk Assessment Environment Variables
# ==============================================================================
# Salin file ini ke .env atau .env.local:
#   cp .env.example .env.local
#
# PERINGATAN KEAMANAN (docs/security(1).md):
# JANGAN PERNAH menambahkan prefix NEXT_PUBLIC_ pada API Key atau Token rahasia
# karena akan tereskpos ke browser client.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Model Configuration (Server-Side Only)
# ------------------------------------------------------------------------------
# API Key untuk model Google Gemini. Dapatkan di: https://aistudio.google.com/
# Digunakan untuk ekstraksi entitas dinamis, analisis klaim bahasa alami, dan penalaran risiko.
# Jika dikosongkan, sistem otomatis fallback ke deterministic rule-based extractor.
GEMINI_API_KEY=

# Model Gemini yang digunakan (default: gemini-2.0-flash atau gemini-1.5-pro)
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 2. OpenClaw VPS Gateway Configuration (Server-Side Only)
# ------------------------------------------------------------------------------
# Alamat gateway OpenClaw yang berjalan di VPS Anda (contoh: http://10.x.x.x:18789)
# Jika dikosongkan, sistem otomatis menjalankan orkestrator agen lokal (in-process).
OPENCLAW_GATEWAY_URL=

# Bearer token autentikasi ke OpenClaw Gateway (jika gateway memerlukan otentikasi)
OPENCLAW_AUTH_TOKEN=

# Timeout panggilan ke OpenClaw Gateway dalam milidetik (default: 15000)
OPENCLAW_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 3. OCR service configuration (Server-Side Only)
# ------------------------------------------------------------------------------
# Base URL for the internal OCR service. Typical local value: http://127.0.0.1:8000
OCR_SERVICE_URL=http://127.0.0.1:8000

# Timeout for OCR requests in milliseconds (default: 20000)
OCR_TIMEOUT_MS=20000

# Optional bearer token for internal OCR service access when private networking is used
OCR_INTERNAL_TOKEN=

# ------------------------------------------------------------------------------
# 4. Optional Public Configuration
# ------------------------------------------------------------------------------
# Base URL endpoint API jika frontend dideploy di domain yang terpisah dari backend API.
# Biarkan kosong jika frontend dan backend berjalan di server Next.js yang sama.
# NEXT_PUBLIC_AGENT_API_BASE_URL=https://api.example.com
